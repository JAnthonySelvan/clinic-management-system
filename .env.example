# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Connection String (Atlas / Cloud MongoDB recommended)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxx.mongodb.net/clinic_management?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_strong_secret_key_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client Application URL)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (Optional, for profile photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Assistant Integration (Optional)
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Use relative '/api' if deploying Backend & Frontend on single server
# Use absolute URL 'https://your-backend.onrender.com/api' if hosted separately
VITE_API_URL=http://localhost:5000/api
