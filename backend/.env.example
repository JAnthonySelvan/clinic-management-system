# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (MongoDB Atlas URL)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/clinic_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Comma-separated for multiple origins, e.g., https://clinic-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (Optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Assistant Integration (Optional)
GEMINI_API_KEY=your_gemini_api_key

# Brevo Email Service Configuration (Optional, for OTP emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@savioursclinic.com
BREVO_SENDER_NAME=Saviours Clinic

